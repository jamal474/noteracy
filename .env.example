PORT=3175
MONGODB_URI=mongodb://localhost:27017/noteracy
SESSION_SECRET=your_session_secret

# ── Mount path ─────────────────────────────────────────────────────────────
# The app answers on a sub-path, not a domain root: it is reached as
# https://<short-domain>/notes/… through a Cloudflare worker that proxies
# without rewriting. Routers, static files, the session cookie path and the
# OAuth callback are all derived from this. Must match the client's
# `homepage` in client/package.json.
BASE_PATH=/notes

# ── Google OAuth ───────────────────────────────────────────────────────────
# The callback is a real, public URL that Google redirects the browser to, so
# it has to be the short-domain one — and the identical string must be listed
# under "Authorized redirect URIs" in the Google Cloud console.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3175/notes/google/callback
# production: https://<short-domain>/notes/google/callback

# Where to send the browser after a successful login / logout. Include the
# mount path; leave unset to fall back to BASE_PATH as a same-origin path.
CLIENT_URL=http://localhost:3000/notes
# production: https://<short-domain>/notes

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated. Only needed for local dev against the CRA dev server — in
# production the client is same-origin. CLIENT_URL is always allowed.
CORS_ORIGINS=http://localhost:3000

# Set to "production" on Render: serves the built client and turns on the
# Secure flag for the session cookie.
NODE_ENV=development
