NODE_ENV=development
PORT=3175
MONGODB_URI=mongodb://localhost:27017/noteracy
SESSION_SECRET=your_session_secret

# Sub-path the app is mounted at. Must match "homepage" in client/package.json.
BASE_PATH=/notes

# Trusted proxy hops in front of this process. nginx is the only one on the VM.
TRUST_PROXY=1

# Must be byte-identical to an "Authorized redirect URI" in the Google console.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3175/notes/google/callback
# production: https://sabo.sh/notes/google/callback

# Where to send the browser after login / logout. Include the mount path.
CLIENT_URL=http://localhost:3000/notes
# production: https://sabo.sh/notes

# Comma-separated extra CORS origins for local dev; CLIENT_URL is always added.
CORS_ORIGINS=http://localhost:3000

# Deploy webhook (VM only). Shared HMAC key, also pasted into GitHub's webhook
# "Secret" field. setup.sh generates one; by hand: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=
DEPLOY_WEBHOOK_PORT=3176
DEPLOY_BRANCH=main
