# __DOMAIN__ — plain HTTP vhost. managed-by: noteracy-setup
# Rendered by deploy/setup.sh; edit the template, not the rendered file.

upstream noteracy_app {
    server 127.0.0.1:__PORT__;
    keepalive 32;
}

upstream noteracy_hook {
    server 127.0.0.1:__HOOK_PORT__;
    keepalive 2;
}

server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name __DOMAIN__ _;

    server_tokens off;
    client_max_body_size 16m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location = /__deploy {
        limit_req zone=noteracyhook burst=3 nodelay;
        proxy_pass         http://noteracy_hook;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host $host;
        # GitHub's HMAC covers the raw body; pass it through unaltered.
        proxy_request_buffering on;
        proxy_read_timeout 30s;
    }

    location / {
        limit_req  zone=noteracyzone burst=40 nodelay;
        limit_conn noteracyconn 24;

        proxy_pass         http://noteracy_app;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Overwrite, not append: after real_ip, $remote_addr is the true client.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;
    }
}
